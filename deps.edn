{:paths ["src/clj" "src/cljc" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/core.async {:mvn/version "1.9.865"}
        metosin/malli {:mvn/version "0.20.3"}
        http-kit/http-kit {:mvn/version "2.8.1"}
        ring/ring-core {:mvn/version "1.15.6"}
        metosin/reitit-ring {:mvn/version "0.11.0"}
        com.taoensso/sente {:mvn/version "1.22.0"}
        com.cognitect/transit-clj {:mvn/version "1.1.367"}}

 :aliases
 {;; Servidor de desarrollo: clojure -M:dev
  :dev {:extra-paths ["dev"]
        :jvm-opts ["-XX:+UseZGC" "-XX:+ZGenerational" "-Xms256m" "-Xmx256m"]
        :main-opts ["-m" "razti.server.core"]}

  ;; Script de assets (C26): clojure -M:assets [all|map|sprites|preview] [--src <dir>]
  :assets {:extra-paths ["dev"]
           :jvm-opts ["-Djava.awt.headless=true"]
           :main-opts ["-m" "assets"]}

  ;; Pruebas JVM (kaocha): clojure -M:test
  :test {:extra-paths ["test/clj" "test/cljc"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts ["-m" "kaocha.runner"]}

  ;; ClojureScript: lo usa shadow-cljs (shadow-cljs.edn → :deps {:aliases [:cljs]})
  :cljs {:extra-paths ["src/cljs" "test/cljc"]
         :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.13"}
                      org.clojure/clojurescript {:mvn/version "1.12.145"}
                      com.cognitect/transit-cljs {:mvn/version "0.8.280"}
                      org.clojure/test.check {:mvn/version "1.1.3"}}}

  ;; Formato: clojure -M:cljfmt check | fix
  :cljfmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
           :main-opts ["-m" "cljfmt.main"]}

  ;; Uberjar: clojure -T:build uber
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
